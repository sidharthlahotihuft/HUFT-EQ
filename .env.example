# Copy this file to .env for local dev, and set the same keys as Environment
# Variables in your Vercel project settings for deployment.

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=              # "anon" / "public" key - safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=      # "service_role" key - server-side ONLY, never expose this
SUPABASE_AUDIO_BUCKET=call-recordings

# --- Transcription (required for hosted/Vercel use) ---
# OpenAI Whisper API - local faster-whisper isn't practical in serverless.
OPENAI_API_KEY=

# Transcription accuracy tuning (all optional - sensible defaults in transcribe.py):
# WHISPER_LANGUAGE: force a language so short/noisy clips aren't misdetected.
#   "en" = English, "hi" = Hindi. Leave BLANK for auto-detect (best for calls
#   that genuinely mix Hindi + English within the same sentence).
WHISPER_LANGUAGE=
# WHISPER_PROMPT: vocabulary/style hint so brand + product + agent names aren't
#   misheard. Leave unset to use the built-in HUFT default; set your own to add
#   your real agent names and top product names. Set to empty to disable.
WHISPER_PROMPT=
# WHISPER_TEMPERATURE: keep at 0 for deterministic output (avoids Whisper
#   looping/hallucinating on silence). Only raise if you know why.
WHISPER_TEMPERATURE=0
# OPENAI_WHISPER_MODEL=whisper-1

# --- AI Scoring: pick ONE (Claude is tried first, falls back to a keyword
# heuristic if neither key is set - every score is editable by hand either way) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_SCORING_MODEL=gpt-4o-mini   # used only if ANTHROPIC_API_KEY is blank

PORT=5001
