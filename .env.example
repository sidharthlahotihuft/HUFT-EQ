# Copy this file to .env for local dev, and set the SAME keys as Environment
# Variables in your Vercel project (Settings -> Environment Variables).
# Put ONE value after each '=' — no quotes, no inline '#' comments on key lines.

# --- Login / auth (required) ---
# A random long string used to sign session cookies. MUST be set in production
# (Vercel) so logins stay valid across serverless instances. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Users & roles. Roles: "manager" sees the whole team + dashboard; "agent" sees
# only their own calls (matched on agent_name). Provide a JSON list. If unset,
# the single default admin manager below is used.
#   USERS_JSON=[{"email":"manager@headsupfortails.com","password":"...","role":"manager"},{"email":"akhila@headsupfortails.com","password":"...","role":"agent","agent_name":"Akhila"}]
USERS_JSON=

# Fallback single admin (used only when USERS_JSON is blank). Set a plaintext
# password, OR leave blank and set ADMIN_PASSWORD_HASH (a werkzeug hash).
ADMIN_EMAIL=admin@headsupfortails.com
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# --- Data retention (privacy) ---
# Calls + their audio are auto-deleted after this many days by the /api/cleanup
# job (Vercel Cron runs it daily; see vercel.json).
RETENTION_DAYS=90
# Secret that authorises the cleanup job. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Mask phone/email/card/PIN in transcripts before AI + storage (1=on).
MASK_PII=1

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=call-recordings

# --- Transcription: Deepgram Nova-3 (recommended) ---
# Verbatim transcription + HUFT Agent/Customer speaker labels in one call.
# Get a key at https://deepgram.com. Used first when set.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
WHISPER_ROMANIZE=1
SPEAKER_LABEL=1

# Whisper fallback (optional; only used if DEEPGRAM_API_KEY is blank).
OPENAI_API_KEY=

# --- Scoring (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_SCORING_MODEL=gpt-4o-mini

PORT=5001
