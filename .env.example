# Copy this file to .env for local dev, and set the SAME keys as Environment
# Variables in your Vercel project (Settings -> Environment Variables).
# Put ONE value after each '=' — no quotes, no inline '#' comments on key lines.

# --- Login / auth (required) ---
# A random long string used to sign session cookies. MUST be set in production
# (Vercel) so logins stay valid across serverless instances. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The single admin login. Set a plaintext password here, OR leave ADMIN_PASSWORD
# blank and set ADMIN_PASSWORD_HASH (a werkzeug hash) instead.
ADMIN_EMAIL=admin@headsupfortails.com
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=      # optional: werkzeug hash instead of plaintext above

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=call-recordings

# --- Transcription: Deepgram Nova-3 (recommended) ---
# Verbatim transcription + HUFT Agent/Customer speaker labels in one call.
# Get a key at https://deepgram.com. Used first when set.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
WHISPER_ROMANIZE=1
SPEAKER_LABEL=1

# Whisper fallback (optional; only used if DEEPGRAM_API_KEY is blank).
OPENAI_API_KEY=

# --- Scoring (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_SCORING_MODEL=gpt-4o-mini

PORT=5001
